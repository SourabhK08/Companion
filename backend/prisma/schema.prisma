// Prisma Schema for Modhuralap
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Registered user — supports local auth and future OAuth providers.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   /// Nullable: OAuth-only users won't have a password
  fullName      String
  phone         String?
  gender        String?
  dateOfBirth   DateTime?
  city          String?
  avatar        String?
  bio           String?
  interests     String[]  @default([])
  languages     String[]  @default([])
  linkedinUrl   String?
  isVerified    Boolean   @default(false)
  authProvider  String    @default("local") /// "local" | "google" | "microsoft"

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  companionProfile    CompanionProfile?
  savedCompanions     SavedCompanion[]
  conversationsAsUser1 Conversation[] @relation("ConversationsAsUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationsAsUser2")
  sentMessages         Message[]      @relation("SentMessages")
  wallet               Wallet?
  clientBookings       Booking[]      @relation("ClientBookings")
  notifications        Notification[]
  coFounderProfile    CoFounderProfile?
  chatSubscriptions   ChatSubscription[]
  profilePhotos       ProfilePhoto[]

  @@map("users")
}

/// Profile photo stored in Azure Blob Storage.
/// Only metadata is stored in the database — never the image binary.
/// storageKey is the blob path: users/{userId}/{uuid}.webp
model ProfilePhoto {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  storageKey       String   @unique  /// Azure blob path, e.g. "users/abc123/uuid.webp"
  originalFilename String?            /// Original name the user uploaded (for display only)
  mimeType         String?            /// e.g. "image/jpeg", "image/webp"
  sizeBytes        Int?               /// File size in bytes
  width            Int?               /// Image width in pixels (populated after confirmation)
  height           Int?               /// Image height in pixels (populated after confirmation)

  sortOrder        Int      @default(0)
  isProfilePhoto   Boolean  @default(false)  /// The user's current avatar

  status           String   @default("PENDING")  /// "PENDING" | "CONFIRMED" | "FAILED"

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@map("profile_photos")
}

/// 1-to-1 conversation thread between two users.
/// participant1 is always the user with the lexicographically smaller ID
/// to guarantee uniqueness of the pair.
model Conversation {
  id            String    @id @default(cuid())
  participant1  String
  participant2  String

  user1         User      @relation("ConversationsAsUser1", fields: [participant1], references: [id], onDelete: Cascade)
  user2         User      @relation("ConversationsAsUser2", fields: [participant2], references: [id], onDelete: Cascade)

  messages      Message[]
  lastMessageAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([participant1, participant2])
  @@map("conversations")
}

/// Individual chat message within a conversation.
model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  content         String
  type            String   @default("text") /// "text" | "image"
  isRead          Boolean  @default(false)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// A user's companion profile — visible in Explore pages.
/// Each user can have at most one companion profile (1:1 relation).
/// Gender-based filtering uses the parent User's gender field.
model CompanionProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  hourlyRate   Int        @default(0)
  rating       Float      @default(5.0)
  reviewCount  Int        @default(0)
  responseRate Int        @default(100)
  isAvailable  Boolean    @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedByUsers SavedCompanion[]
  bookings     Booking[]        @relation("CompanionBookings")

  @@map("companion_profiles")
}

/// Tracking which users have saved/liked which companion profiles
model SavedCompanion {
  id                 String   @id @default(cuid())
  userId             String
  companionProfileId String
  createdAt          DateTime @default(now())

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionProfile   CompanionProfile @relation(fields: [companionProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, companionProfileId])
  @@map("saved_companions")
}

/// Refresh tokens for secure JWT rotation.
/// Stored in DB so they can be individually revoked (e.g., on logout).
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// User wallet for mock payments.
/// Balance stored in paisa (₹1 = 100) to avoid floating-point issues.
model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance    Int      @default(0)  /// Available balance in paisa
  heldAmount Int      @default(0)  /// Amount frozen for pending bookings
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

/// Ledger of all wallet transactions.
model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   /// "ADD_MONEY" | "BOOKING_HOLD" | "BOOKING_DEDUCT" | "HOLD_RELEASE" | "EARNING" | "REFUND"
  amount      Int      /// Always positive; direction determined by type
  description String
  bookingId   String?  /// Link to related booking (if applicable)
  createdAt   DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

/// Booking between a client (User) and a CompanionProfile.
/// Follows hold-then-deduct payment pattern.
model Booking {
  id                  String   @id @default(cuid())
  clientId            String
  companionProfileId  String

  client              User              @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  companionProfile    CompanionProfile  @relation("CompanionBookings", fields: [companionProfileId], references: [id], onDelete: Cascade)

  /// Booking details
  scheduledDate       DateTime
  durationHours       Int
  venue               String?
  note                String?

  /// Pricing in paisa
  hourlyRate          Int
  subtotal            Int
  platformFee         Int
  totalAmount         Int

  /// Status machine
  status              String   @default("PENDING_ACCEPTANCE")
  /// PENDING_ACCEPTANCE | CONFIRMED | REJECTED | CANCELLED_BY_CLIENT
  /// IN_PROGRESS | COMPLETED | EXPIRED | DISPUTED

  /// OTP system (Ola/Uber style)
  otpCode             String?
  otpExpiresAt        DateTime?
  otpVerifiedAt       DateTime?
  otpAttempts         Int      @default(0)

  /// Meeting timestamps
  meetingStartedAt    DateTime?
  meetingEndedAt      DateTime?

  /// Companion response
  companionRespondedAt DateTime?
  rejectionReason     String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([clientId, status])
  @@index([companionProfileId, status])
  @@map("bookings")
}

/// Per-user notification — supports all activity types + promotional messages.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   /// "WALLET" | "BOOKING" | "MEETING" | "SYSTEM" | "PROMO"
  title     String
  body      String
  icon      String?  /// Optional icon name (e.g., "wallet", "calendar", "check")
  linkUrl   String?  /// Optional deep-link (e.g., "/bookings/xyz", "/wallet")
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}


/// Co-Founder profile — users who want to find business partners.
/// Linked 1:1 with User, similar to CompanionProfile.
model CoFounderProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  linkedinUrl    String   /// Required LinkedIn profile URL
  workInterests  String[] @default([])  /// e.g. ["AI/ML", "SaaS", "FinTech"]
  pitch          String?  /// Short pitch / idea description
  lookingFor     String?  /// What kind of partner they seek
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("cofounder_profiles")
}

/// Chat subscription — paid access to message co-founders.
model ChatSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan        String   /// "WEEKLY" | "MONTHLY" | "QUARTERLY"
  amountPaid  Int      /// Amount in paisa
  startDate   DateTime @default(now())
  endDate     DateTime
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  @@index([userId, endDate])
  @@map("chat_subscriptions")
}
